{
  "name": "weather-cover",
  "version": "1.0.0",
  "description": "WeatherCover — modern, fast and animated weather app",
  "main": "electron/main.cjs",
  "author": "WeatherCover",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "package:win": "npm run build && electron-packager . WeatherCover --platform=win32 --arch=x64 --out=release --overwrite --prune=true --ignore='^/node_modules' --ignore='^/release' --ignore='^\\.git' --ignore='^\\.github'",
    "package:linux": "npm run build && electron-packager . WeatherCover --platform=linux --arch=x64 --out=release --overwrite --prune=true --ignore='^/node_modules' --ignore='^/release' --ignore='^\\.git' --ignore='^\\.github'",
    "serve": "node server.cjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "vite": "^6.0.7"
  }
}
