{
  "name": "agroprognoz-corn",
  "productName": "AgroPrognoz",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "description": "АгроПрогноз — Кукуруза: выбор территории, параметры прогноза и погодные показатели для выращивания кукурузы.",
  "author": "AgroPrognoz",
  "license": "MIT",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "icon": "node scripts/build-icon.mjs",
    "splash": "node scripts/build-splash.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test tests/date-period.test.mjs tests/month-input.test.mjs tests/forecast-engine.test.mjs tests/database.test.mjs tests/csv.test.mjs tests/license.test.mjs tests/license-studio.test.mjs tests/activation-doctor.test.mjs",
    "test:smoke": "node tests/smoke/run-smoke.mjs",
    "test:gate": "node tests/smoke/run-gate.mjs",
    "test:activation": "node tests/smoke/run-activation.mjs",
    "harden": "node scripts/harden.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "license:studio": "node scripts/license-studio/main.mjs",
    "license:keygen": "node scripts/license-tool.mjs keygen",
    "license:issue": "node scripts/license-tool.mjs issue",
    "license:verify": "node scripts/license-tool.mjs verify",
    "license:revoke": "node scripts/license-tool.mjs revoke",
    "license:keys": "node scripts/license-tool.mjs keys",
    "license:fingerprint": "node scripts/license-tool.mjs fingerprint",
    "license:status": "node scripts/activation-doctor.mjs status",
    "license:machine": "node scripts/activation-doctor.mjs machine",
    "license:reset": "node scripts/activation-doctor.mjs reset",
    "activation:selftest": "node scripts/activation-doctor.mjs selftest",
    "station": "node station/src/main.mjs",
    "station:test": "node --test station/tests/station.test.mjs station/tests/standalone.test.mjs station/tests/personal.test.mjs",
    "station:export": "node scripts/export-station.mjs",
    "station:sync": "node station/scripts/sync-vendor.mjs",
    "dist:win": "node scripts/patch-portable-nsi.mjs && npm run harden && electron-builder --win portable",
    "station:standalone": "node station/scripts/build-standalone.mjs",
    "license:page": "node station/scripts/build-personal.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@fontsource/inter": "5.3.0",
    "chart.js": "4.5.1",
    "electron": "43.6.0",
    "electron-builder": "26.15.3",
    "javascript-obfuscator": "5.7.0",
    "leaflet": "1.9.4",
    "lucide-static": "1.44.0",
    "playwright": "1.56.1",
    "sharp": "0.35.4",
    "sql.js": "1.14.2",
    "topojson-client": "3.1.0",
    "vite": "7.3.6",
    "world-atlas": "2.0.2"
  },
  "build": {
    "appId": "local.agroprognoz.corn",
    "productName": "AgroPrognoz",
    "copyright": "MIT licensed. Includes Natural Earth and OpenStreetMap/CARTO/Esri map data under their own terms.",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "hardened/electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.png"
        ]
      },
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AgroPrognoz-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "AgroPrognoz-${version}-portable.exe",
      "requestExecutionLevel": "user",
      "splashImage": "build/splash.bmp"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
